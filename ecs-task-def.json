{
  "family": "gitmago-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::654654290061:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "gitmago",
      "image": "654654290061.dkr.ecr.ap-northeast-2.amazonaws.com/gitmago:latest",
      "portMappings": [
        {
          "containerPort": 443,
          "hostPort": 443
        }
      ],
      "essential": true
    }
  ]
}
